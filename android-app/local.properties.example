# Copy APP_API_TOKEN into your existing local.properties file.
# Keep sdk.dir as generated by Android Studio.
APP_API_TOKEN=replace-with-cloudflare-worker-app-api-token

# Optional GitHub Actions fallback. Use a fine-grained token limited to the
# sRect/esp32 repository with Actions: write permission only.
GITHUB_ACTIONS_TOKEN=replace-with-fine-grained-github-token
GITHUB_ACTIONS_REF=feature/initial-project
